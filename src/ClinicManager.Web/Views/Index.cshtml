@model IEnumerable<ClinicManager.Web.DTOs.PatientDto>

@{
    ViewData["Title"] = "Lista Pacjentów";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2>Zarządzanie Pacjentami</h2>

    <a asp-action="Create" class="btn btn-success">
        <i class="bi bi-person-plus"></i> Dodaj pacjenta
    </a>
</div>

<form asp-action="Index" method="get" class="mb-4">
    <div class="input-group">
        <input type="text" name="searchTerm" value="@ViewData["CurrentFilter"]"
               class="form-control" placeholder="Szukaj po nazwisku lub numerze PESEL..." />
        <button type="submit" class="btn btn-primary">Szukaj</button>
        <a asp-action="Index" class="btn btn-outline-secondary">Wyczyść</a>
    </div>
</form>

<div class="table-responsive">
    <table class="table table-striped table-hover align-middle">
        <thead class="table-light">
            <tr>
                <th>Imię</th>
                <th>Nazwisko</th>
                <th>PESEL</th>
                <th>Nr Ubezpieczenia</th>
                <th class="text-end">Akcje</th>
            </tr>
        </thead>
        <tbody>
            @if (!Model.Any())
            {
                <tr>
                    <td colspan="5" class="text-center text-muted">Brak pacjentów do wyświetlenia.</td>
                </tr>
            }
            else
            {
                @foreach (var patient in Model)
                {
                    <tr>
                        <td>@patient.FirstName</td>
                        <td>@patient.LastName</td>
                        <td>@patient.Pesel</td>
                        <td>@(patient.InsuranceNumber ?? "-")</td>
                        <td class="text-end">
                            <a href="#" class="btn btn-sm btn-outline-primary">Edytuj</a>
                            <a href="#" class="btn btn-sm btn-outline-danger">Usuń</a>
                        </td>
                    </tr>
                }
            }
        </tbody>
    </table>
</div>