@model IEnumerable<ClinicManager.Web.DTOs.VisitDto>
@{
    ViewData["Title"] = "Wizyty";
}

<div class="d-flex justify-content-between align-items-center mb-3">
	<h2>Lista wizyt</h2>
	@if (User.IsInRole("Admin") || User.IsInRole("Rejestratorka"))
	{
		<a asp-action="Create" class="btn btn-primary">
			<i class="bi bi-plus-circle"></i> Zarejestruj wizytę
		</a>
	}
</div>

@if (User.Identity.IsAuthenticated && !User.IsInRole("Lekarz") && !User.IsInRole("Admin") && !User.IsInRole("Rejestratorka"))
{
	<div class="card border-info shadow-sm mb-4 rounded-3">
		<div class="card-header bg-info text-white fw-bold">
			<i class="bi bi-wallet2"></i> Twoje Rozliczenia Medyczne
		</div>
		<div class="card-body d-flex flex-column flex-md-row justify-content-between align-items-center">
			<div class="mb-3 mb-md-0">
				<h5 class="card-title fw-bold text-dark mb-1">Twój miesięczny raport kosztów</h5>
				<p class="card-text text-muted mb-0">Kliknij przycisk obok, aby pobrać szczegółowe zestawienie kosztów wizyt, leków i zabiegów z obecnego miesiąca (PDF).</p>
			</div>
			<div>
				<a asp-controller="Reports" 
				   asp-action="DownloadMyPatientReport" 
				   asp-route-year="@DateTime.Now.Year" 
				   asp-route-month="@DateTime.Now.Month" 
				   class="btn btn-info text-white shadow-sm px-4 py-2">
					<i class="bi bi-file-earmark-pdf me-2"></i> Pobierz plik PDF
				</a>
			</div>
		</div>
	</div>
}

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="table-responsive">
    <table class="table table-hover table-bordered align-middle">
        <thead class="table-dark">
            <tr>
                <th>Data</th>
                <th>Pacjent</th>
                <th>Lekarz</th>
                <th>Status</th>
                <th>Opis</th>
                <th>Koszt</th>
                <th>Akcje</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var visit in Model)
            {
                <tr>
                    <td>@visit.ScheduledDate.ToString("dd.MM.yyyy HH:mm")</td>
                    <td>@visit.PatientFullName</td>
                    <td>@visit.DoctorName</td>
                    <td>
                        @{
                            var badgeClass = visit.Status switch
                            {
                                "Zaplanowana"  => "bg-secondary",
                                "Potwierdzona" => "bg-info text-dark",
                                "W trakcie"    => "bg-warning text-dark",
                                "Zakończona"   => "bg-success",
                                "Anulowana"    => "bg-danger",
                                _              => "bg-secondary"
                            };
                        }
                        <span class="badge @badgeClass">@visit.Status</span>
                    </td>
                    <td>@(visit.Description ?? "—")</td>
                    <td>@visit.TotalCost.ToString("C")</td>
                    <td>
                        <a asp-action="Details" asp-route-id="@visit.Id" class="btn btn-sm btn-outline-primary">Szczegóły</a>
                        @if (User.IsInRole("Admin") || User.IsInRole("Rejestratorka"))
                        {
                            <form asp-action="Delete" method="post" class="d-inline"
                                  onsubmit="return confirm('Czy na pewno chcesz anulować tę wizytę?');">
                                <input type="hidden" name="id" value="@visit.Id" />
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-sm btn-outline-danger">Anuluj</button>
                            </form>
                        }
                    </td>
                </tr>
            }
            @if (!Model.Any())
            {
                <tr>
                    <td colspan="7" class="text-center text-muted">Brak wizyt do wyświetlenia.</td>
                </tr>
            }
        </tbody>
    </table>
</div>
