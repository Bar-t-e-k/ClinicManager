@model IEnumerable<ClinicManager.Web.DTOs.PatientDto>
@{
    ViewData["Title"] = "Pacjenci";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>Lista pacjentów</h2>
    @if (User.IsInRole("Admin") || User.IsInRole("Rejestratorka"))
    {
        <a asp-action="Create" class="btn btn-primary">+ Dodaj pacjenta</a>
    }
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show">
        @TempData["Success"] <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<form method="get" class="mb-3 d-flex gap-2">
    <input type="text" name="searchTerm" value="@ViewData["CurrentFilter"]"
           class="form-control" placeholder="Szukaj po nazwisku lub PESEL…" />
    <button type="submit" class="btn btn-outline-primary">Szukaj</button>
    @if (ViewData["CurrentFilter"] != null)
    {
        <a asp-action="Index" class="btn btn-outline-secondary">Wyczyść</a>
    }
</form>

<div class="table-responsive">
    <table class="table table-hover table-bordered align-middle">
        <thead class="table-dark">
            <tr>
                <th>Nazwisko</th>
                <th>Imię</th>
                <th>PESEL</th>
                <th>Nr ubezpieczenia</th>
                <th>Akcje</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var patient in Model)
            {
                <tr>
                    <td>@patient.LastName</td>
                    <td>@patient.FirstName</td>
                    <td>@patient.Pesel</td>
                    <td>@(patient.InsuranceNumber ?? "—")</td>
                    <td>
                        <a asp-action="Edit" asp-route-id="@patient.Id" class="btn btn-sm btn-outline-primary">Edytuj</a>
                        @if (User.IsInRole("Admin"))
                        {
                            <form asp-action="Delete" method="post" class="d-inline"
                                  onsubmit="return confirm('Usunąć pacjenta?');">
                                <input type="hidden" name="id" value="@patient.Id" />
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-sm btn-outline-danger">Usuń</button>
                            </form>
                        }
                    </td>
                </tr>
            }
            @if (!Model.Any())
            {
                <tr>
                    <td colspan="5" class="text-center text-muted">Brak pacjentów.</td>
                </tr>
            }
        </tbody>
    </table>
</div>