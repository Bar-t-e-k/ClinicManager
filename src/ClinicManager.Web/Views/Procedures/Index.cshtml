@model IEnumerable<ClinicManager.Web.DTOs.CreateUpdateProcedureDto>
@{
    ViewData["Title"] = "Katalog procedur medycznych";
    var canManage = User.IsInRole("Admin") || User.IsInRole("Rejestratorka");
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>Katalog procedur medycznych</h2>
    @if (canManage)
    {
        <a asp-action="Create" class="btn btn-primary">
            <i class="bi bi-plus-circle"></i> Dodaj procedurę
        </a>
    }
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show">
        @TempData["Success"] <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="table-responsive">
    <table class="table table-hover table-bordered align-middle">
        <thead class="table-dark">
            <tr>
                <th>Opis procedury</th>
                <th class="text-end">Koszt świadczenia</th>
                <th class="text-center">Status</th>
                @if (canManage)
                {
                    <th>Akcje</th>
                }
            </tr>
        </thead>
        <tbody>
            @foreach (var proc in Model)
            {
                <tr class="@(!proc.IsActive ? "table-secondary text-muted" : "")">
                    <td>@proc.Description</td>
                    <td class="text-end">@proc.Cost.ToString("C")</td>
                    <td class="text-center">
                        @if (proc.IsActive)
                        {
                            <span class="badge bg-success">Aktywna</span>
                        }
                        else
                        {
                            <span class="badge bg-secondary">Nieaktywna</span>
                        }
                    </td>
                    @if (canManage)
                    {
                        <td>
                            <a asp-action="Edit" asp-route-id="@proc.Id" class="btn btn-sm btn-outline-primary">Edytuj</a>
                            @if (proc.IsActive)
                            {
                                <form asp-action="Deactivate" asp-route-id="@proc.Id" method="post" class="d-inline"
                                      onsubmit="return confirm('Dezaktywować tę procedurę?');">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-sm btn-outline-danger">Dezaktywuj</button>
                                </form>
                            }
                        </td>
                    }
                </tr>
            }
            @if (!Model.Any())
            {
                <tr>
                    <td colspan="@(canManage ? 4 : 3)" class="text-center text-muted">Brak procedur w katalogu.</td>
                </tr>
            }
        </tbody>
    </table>
</div>
