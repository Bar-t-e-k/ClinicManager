<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - ClinicManager.Web</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/ClinicManager.Web.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">
            <div class="container-fluid">
                <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">ClinicManager.Web</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="Home" asp-action="Index">Strona główna</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="Home" asp-action="Privacy">Prywatność</a>
                        </li>
                        @if (User.IsInRole("Admin") || User.IsInRole("Lekarz") || User.IsInRole("Rejestratorka"))
                        {
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-area="" asp-controller="Patients" asp-action="Index">Pacjenci</a>
                            </li>
                        }
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-controller="Visits" asp-action="Index">Wizyty</a>
                        </li>
                        @if (User.IsInRole("Admin") || User.IsInRole("Lekarz") || User.IsInRole("Rejestratorka"))
                        {
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-controller="Medications" asp-action="Index">Leki</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-controller="Procedures" asp-action="Index">Procedury</a>
                            </li>
                        }
                        <li class="nav-item">
	                        <a class="nav-link text-dark" asp-area="" asp-controller="Settings" asp-action="Index">Ustawienia</a>
                        </li>
                        <partial name="_LoginPartial" />
                    </ul>
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
	    <main role="main" class="pb-3">
		    <div class="container">
			    <main role="main" class="pb-3">
				    @{
					    var _success = TempData["Success"] as string;
					    var _error   = TempData["Error"]   as string;
				    }
				    @if (!string.IsNullOrEmpty(_success))
				    {
					    <div class="alert alert-success alert-dismissible fade show mt-2" role="alert">
						    @_success
						    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
					    </div>
				    }
				    @if (!string.IsNullOrEmpty(_error))
				    {
					    <div class="alert alert-danger alert-dismissible fade show mt-2" role="alert">
						    @_error
						    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
					    </div>
				    }

				    @RenderBody()
			    </main>
		    </div>
	    </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2026 - ClinicManager.Web - <a asp-area="" asp-controller="Home" asp-action="Privacy">Prywatność</a>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>