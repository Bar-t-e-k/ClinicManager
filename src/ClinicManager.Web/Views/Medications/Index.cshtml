@model IEnumerable<ClinicManager.Web.DTOs.CreateUpdateMedicationDto>
@{
    ViewData["Title"] = "Katalog leków";
}

<div class="d-flex justify-content-between align-items-center mb-3">
	<h2>Katalog leków</h2>
	@if (User.IsInRole("Admin") || User.IsInRole("Rejestratorka"))
	{
		<a asp-action="Create" class="btn btn-primary">
			<i class="bi bi-plus-circle"></i> Dodaj lek
		</a>
	}
</div>

<div class="table-responsive">
    <table class="table table-hover table-bordered align-middle">
        <thead class="table-dark">
            <tr>
                <th>Nazwa</th>
                <th>Opis</th>
                <th class="text-end">Cena</th>
                <th class="text-center">Status</th>
                @if (User.IsInRole("Admin") || User.IsInRole("Rejestratorka"))
                {
                    <th>Akcje</th>
                }
            </tr>
        </thead>
        <tbody>
            @foreach (var med in Model)
            {
                <tr class="@(!med.IsActive ? "table-secondary text-muted" : "")">
                    <td>@med.Name</td>
                    <td>@(med.Description ?? "—")</td>
                    <td class="text-end">@med.Price.ToString("C")</td>
                    <td class="text-center">
                        @if (med.IsActive)
                        {
                            <span class="badge bg-success">Aktywny</span>
                        }
                        else
                        {
                            <span class="badge bg-secondary">Nieaktywny</span>
                        }
                    </td>
                    @if (User.IsInRole("Admin") || User.IsInRole("Rejestratorka"))
                    {
	                    <td>
	                    <a asp-action="Edit" asp-route-id="@med.Id" class="btn btn-sm btn-outline-primary">Edytuj</a>
	                    </td>
                    }
                </tr>
            }
            @if (!Model.Any())
            {
                <tr>
                    <td colspan="5" class="text-center text-muted">Brak leków w katalogu.</td>
                </tr>
            }
        </tbody>
    </table>
</div>