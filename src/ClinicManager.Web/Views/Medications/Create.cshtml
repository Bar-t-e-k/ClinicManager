@model ClinicManager.Web.DTOs.CreateMedicationDto
@{
	ViewData["Title"] = "Dodaj lek";
}

<h2 class="mb-4">Dodaj lek do katalogu</h2>

<div class="row">
	<div class="col-md-5">
		<form asp-action="Create" method="post">
			<div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

			<div class="mb-3">
				<label asp-for="Name" class="form-label fw-semibold"></label>
				<input asp-for="Name" class="form-control" placeholder="np. Amoxicillin 500mg" />
				<span asp-validation-for="Name" class="text-danger small"></span>
			</div>

			<div class="mb-3">
				<label asp-for="Description" class="form-label fw-semibold"></label>
				<textarea asp-for="Description" class="form-control" rows="3"
                          placeholder="Wskazania, dawkowanie…"></textarea>
				<span asp-validation-for="Description" class="text-danger small"></span>
			</div>

			<div class="mb-3">
				<label asp-for="Price" class="form-label fw-semibold"></label>
				<div class="input-group">
					<input asp-for="Price" type="number" step="0.01" min="0.01" class="form-control" />
					<span class="input-group-text">PLN</span>
				</div>
				<span asp-validation-for="Price" class="text-danger small"></span>
			</div>

			<div class="d-flex gap-2">
				<button type="submit" class="btn btn-primary">Zapisz</button>
				<a asp-action="Index" class="btn btn-outline-secondary">Anuluj</a>
			</div>
		</form>
	</div>
</div>

@section Scripts {
	@{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}